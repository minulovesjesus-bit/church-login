# Runtime mode: development, test, or production
APP_ENV=
# Public Supabase project URL used by the browser
NEXT_PUBLIC_SUPABASE_URL=
# Public Supabase publishable key; this is browser configuration, not a secret
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase project URL used by FastAPI
SUPABASE_URL=
# Supabase publishable key used by FastAPI Auth verification
SUPABASE_PUBLISHABLE_KEY=
# Supabase JWT audience
SUPABASE_JWT_AUDIENCE=
# Supabase JWKS URL
SUPABASE_JWKS_URL=
# Server-only backend database connection URL; never use a NEXT_PUBLIC_ name
DATABASE_URL=
# PostgreSQL connection timeout in seconds (1-5)
DATABASE_CONNECT_TIMEOUT_SECONDS=
# Per-transaction PostgreSQL statement timeout in milliseconds (1-7999)
# The connection plus statement timeout budget must not exceed 8000ms
DATABASE_STATEMENT_TIMEOUT_MS=
# Optional local FastAPI origin used by Next.js development rewrites
FASTAPI_ORIGIN=
# Google OAuth client ID configured in Supabase
GOOGLE_CLIENT_ID=
# Server-only Google OAuth client secret configured in Supabase
GOOGLE_CLIENT_SECRET=
# Initial administrator email address
INITIAL_ADMIN_EMAIL=
# Server-only secret for short-lived teacher OAuth intents; generate independently
TEACHER_OAUTH_INTENT_SECRET=
# Server-only Argon2 hash for the shared kiosk password; never store the raw password
KIOSK_PASSWORD_HASH=
# Server-only secret for kiosk access signing, refresh-token hashing, and rate-limit keys; generate independently
KIOSK_COOKIE_SECRET=
# Set true only for loopback development/test over plain HTTP; Vercel always overrides to Secure
KIOSK_INSECURE_LOCAL_COOKIES=
# Separate server-only secret (at least 32 random bytes) used to sign attendance QR tokens; do not reuse KIOSK_COOKIE_SECRET
QR_SIGNING_SECRET=
# Allowed frontend origins
ALLOWED_FRONTEND_ORIGINS=
# Fixed application timezone
APP_TIMEZONE=
