# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase JWT audience
SUPABASE_JWT_AUDIENCE=
# Supabase JWKS URL
SUPABASE_JWKS_URL=
# Backend database connection URL
DATABASE_URL=
# Google OAuth client ID configured in Supabase
GOOGLE_CLIENT_ID=
# Google OAuth client secret configured in Supabase
GOOGLE_CLIENT_SECRET=
# Initial administrator email address
INITIAL_ADMIN_EMAIL=
# Argon2 hash for the shared kiosk password
KIOSK_PASSWORD_HASH=
# Secret used to sign attendance QR tokens
QR_SIGNING_SECRET=
# Allowed frontend origins
ALLOWED_FRONTEND_ORIGINS=
# Fixed application timezone
APP_TIMEZONE=
