# 이 파일을 `.env.local`로 복사한 뒤 실제 값을 입력한다.
# 각 설명은 해당 KEY 바로 위에 둔다. 비밀 값이 포함된 `.env.local`은 Git에 커밋하지 않는다.
# 로컬 Supabase 값 확인 명령: npx supabase status -o env

# =============================================================================
# 1. 실행 환경과 시간대
# =============================================================================
# APP_ENV: 로컬은 development, 테스트 fixture는 test, Vercel 운영은 production을 사용한다.
APP_ENV=development

# APP_TIMEZONE: 출결 날짜와 주간 일정을 계산할 시간대. 현재 애플리케이션은 Asia/Seoul만 허용한다.
APP_TIMEZONE=Asia/Seoul

# =============================================================================
# 2. 브라우저에서 사용하는 Supabase 공개 설정
# =============================================================================
# NEXT_PUBLIC_SUPABASE_URL: 브라우저가 사용할 Supabase Project URL.
# 로컬에서는 `npx supabase status -o env`의 API_URL 값을 입력한다.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: 브라우저용 publishable key.
# 로컬에서는 위 명령의 PUBLISHABLE_KEY를 입력한다. service_role/secret key는 절대 넣지 않는다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-PUBLISHABLE_KEY

# =============================================================================
# 3. FastAPI의 Supabase 인증 검증 설정
# =============================================================================
# SUPABASE_URL: FastAPI가 사용할 Supabase Project URL. NEXT_PUBLIC_SUPABASE_URL과 같은 값이다.
SUPABASE_URL=http://127.0.0.1:54321

# SUPABASE_PUBLISHABLE_KEY: FastAPI가 인증 검증에 사용할 publishable key.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY와 같은 값을 사용한다.
SUPABASE_PUBLISHABLE_KEY=replace-with-local-PUBLISHABLE_KEY

# SUPABASE_JWT_AUDIENCE: Supabase 로그인 사용자 JWT의 audience. 기본값 authenticated를 유지한다.
SUPABASE_JWT_AUDIENCE=authenticated

# SUPABASE_JWKS_URL: Supabase JWT 서명을 확인할 공개 키 주소.
# Project URL 뒤에 `/auth/v1/.well-known/jwks.json`을 붙인다.
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# Google Client ID와 Client Secret은 이 파일이 아니라
# Supabase Dashboard → Authentication → Providers → Google에 등록한다.

# =============================================================================
# 4. PostgreSQL 연결과 timeout
# =============================================================================
# DATABASE_URL: FastAPI가 사용할 PostgreSQL 접속 URI. 브라우저에 노출하면 안 되는 서버 전용 비밀 값이다.
# 로컬에서는 `npx supabase status -o env`의 DB_URL 값을 사용한다.
# Vercel에서는 Supabase Dashboard → Connect → Transaction pooler의 6543 URI를 사용한다.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# DATABASE_CONNECT_TIMEOUT_SECONDS: DB 연결 대기 시간(초). 허용 범위 1~5, 권장값 2.
DATABASE_CONNECT_TIMEOUT_SECONDS=2

# DATABASE_STATEMENT_TIMEOUT_MS: 쿼리 실행 제한(ms). 허용 범위 1~7999, 권장값 5000.
# 연결 제한과 쿼리 제한의 합계는 8000ms 이하여야 한다.
DATABASE_STATEMENT_TIMEOUT_MS=5000

# =============================================================================
# 5. 로컬 Next.js ↔ FastAPI 라우팅과 CORS
# =============================================================================
# FASTAPI_ORIGIN: 로컬 Next.js가 `/api` 요청을 전달할 FastAPI 주소. Vercel에는 등록하지 않는다.
FASTAPI_ORIGIN=http://127.0.0.1:8000

# ALLOWED_FRONTEND_ORIGINS: FastAPI가 허용할 정확한 프론트엔드 origin 목록(쉼표 구분, 경로 금지).
ALLOWED_FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# =============================================================================
# 6. 최초 관리자
# =============================================================================
# INITIAL_ADMIN_EMAILS: 최초 admin으로 bootstrap할 Google 인증 완료 사용자 이메일 목록.
# 쉼표로 구분하며 공백과 대소문자는 자동 정규화된다. 각 계정은 첫 로그인 때 한 번만 bootstrap된다.
# INITIAL_ADMIN_EMAILS=codeyoma@gmail.com,second-admin@example.test
# INITIAL_ADMIN_EMAIL: 기존 단일 이메일 설정과의 호환용. 신규 배포에서는 위 복수형을 사용한다.
# INITIAL_ADMIN_EMAIL=legacy-admin@example.test

# =============================================================================
# 7. 공용 키오스크 보안
# =============================================================================
# KIOSK_PASSWORD_HASH: `/qr` 기기 등록에 사용할 고정 관리자 비밀번호의 Argon2id hash.
# 원문 비밀번호를 저장하지 않는다. 아래 명령을 실행하고 출력된 한 줄을 그대로 붙여 넣는다.
# 생성 명령: uv run --with argon2-cffi python -c 'from argon2 import PasswordHasher; from getpass import getpass; print("KIOSK_PASSWORD_HASH=" + PasswordHasher().hash(getpass("Kiosk password: ")))'
# KIOSK_PASSWORD_HASH=replace-with-generated-argon2id-hash

# KIOSK_COOKIE_SECRET: 키오스크 쿠키 서명, refresh token hash, rate-limit key용 32바이트 랜덤 값.
# 생성 명령: printf 'KIOSK_COOKIE_SECRET=' && openssl rand -hex 32
# KIOSK_COOKIE_SECRET=replace-with-independent-random-value

# QR_SIGNING_SECRET: 출결 QR token 서명용 32바이트 랜덤 값.
# KIOSK_COOKIE_SECRET과 반드시 다른 값을 사용하며 아래 명령을 별도로 실행한다.
# 생성 명령: printf 'QR_SIGNING_SECRET=' && openssl rand -hex 32
# QR_SIGNING_SECRET=replace-with-another-independent-random-value

# KIOSK_INSECURE_LOCAL_COOKIES: HTTP localhost 개발에서만 true.
# Vercel/HTTPS 운영에서는 false로 설정하거나 등록하지 않는다.
KIOSK_INSECURE_LOCAL_COOKIES=true
